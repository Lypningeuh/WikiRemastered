{
  "manifest_version": 3,
  "name": "WikiRemastered pour Wiki Masters",
  "short_name": "WikiRemastered",
  "version": "1.33.2",
  "description": "Thème graphite, ouvertures de paquets en 3D, collection enrichie, défausse et marché pour Wiki Masters. Extension non officielle.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"},
  "action": {"default_title": "Ouvrir ma collection Wiki Masters", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}},
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["site-theme.js"],
      "css": ["site-theme.css", "site-pages.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["loader.js", "achievements.js"],
      "css": ["integration.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["content.js", "api.js", "network.js", "prices.js", "discard.js", "protection.js", "ui.js", "ui.css", "controls.js", "help.js", "help.css", "duplicates.js", "duplicates.css", "pack-cards.js", "pack-opening.js", "pack-opening.css", "pack-art.svg", "pack-art-puzzle.svg", "card-back-puzzle.svg", "pack-art-green.svg", "card-back-green.svg", "pack-art-globe.svg", "card-back-globe.svg", "logo-wikiremastered.svg", "logo-wikiremastered-compact.svg", "pack-fold.js", "pack-light.js", "market.js", "market-api.js", "market-policy.js", "market-ui.js", "market-ui.css", "late-bid-policy.js", "runtime.js"],
    "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"]
  }]
}
